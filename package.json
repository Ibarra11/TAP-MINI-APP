{
  "name": "hello-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.1.0",
  "tapMiniapp": {
    "output": "dist"
  },
  "scripts": {
    "dev": "tap-miniapp dev",
    "build:target": "rslib build",
    "build:miniapp": "tap-miniapp build",
    "build": "pnpm run build:miniapp",
    "publish": "tap-miniapp publish",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@theaiplatform/miniapp-sdk": "0.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "2.8.1",
    "@module-federation/runtime-tools": "2.8.1",
    "@rsbuild/core": "2.1.9",
    "@rsbuild/plugin-react": "2.1.0",
    "@rslib/core": "0.23.2",
    "@types/node": "25.9.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  }
}
